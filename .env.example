# Variable names only. Copy to .env (gitignored) and fill in locally.
# Never commit real values. Needed only if you run the manual live smoke script (M3b).
GROQ_API_KEY=

# Names for the manual live smoke script (scripts/live_smoke.py). It reads the process
# environment and does not load this file; set these in your shell for the session.
# The key variable's NAME goes in NIRIKSHA_SMOKE_KEY_VARIABLE (for example GROQ_API_KEY above).
NIRIKSHA_SMOKE_BASE_URL=
NIRIKSHA_SMOKE_MODEL=
NIRIKSHA_SMOKE_KEY_VARIABLE=
